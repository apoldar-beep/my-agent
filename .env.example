# Wymagane: klucz API Anthropic (do generowania podsumowania)
ANTHROPIC_API_KEY=

# Dostawca poczty: "mock" (dane testowe) albo "gmail" (Gmail API).
MAIL_PROVIDER=mock

# Opcjonalnie: ścieżka do pliku JSON z przykładowymi wiadomościami dla MockMailProvider.
# MOCK_INBOX_PATH=fixtures/sample_inbox.json

# --- Wymagane, jeśli MAIL_PROVIDER=gmail ---
# Ścieżka do pliku danych klienta OAuth pobranego z Google Cloud Console
# (typ "Desktop app"). Patrz README — sekcja "Konfiguracja Gmail API".
# GMAIL_CLIENT_SECRETS_PATH=client_secret.json

# Opcjonalnie: gdzie cache'ować token odświeżania po pierwszej autoryzacji.
# GMAIL_TOKEN_PATH=.state/gmail_token.json

# Opcjonalnie: dodatkowy filtr wyszukiwania Gmail (składnia jak w polu
# wyszukiwania Gmaila).
# GMAIL_QUERY=in:inbox -in:chats
