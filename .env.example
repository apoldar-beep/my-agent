# Wymagane: klucz API Anthropic (do generowania podsumowania)
ANTHROPIC_API_KEY=

# Dostawca poczty. Na razie zaimplementowany tylko "mock" (dane testowe).
# Po wyborze prawdziwego dostawcy (Gmail API / IMAP) dodaj tu jego zmienne
# konfiguracyjne i zaimplementuj inbox_agent.mail.base.MailProvider.
MAIL_PROVIDER=mock

# Opcjonalnie: ścieżka do pliku JSON z przykładowymi wiadomościami dla MockMailProvider.
# MOCK_INBOX_PATH=fixtures/sample_inbox.json
